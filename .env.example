# For LOCAL runs on your Mac only. Copy to .env (gitignored) and fill in.
# In cloud sessions these come from the environment settings at claude.ai/code instead.
# OpenRouter API key (paid models; runs are limited by spend_cap_eur in the config).
# Prefixed PFS_ so it never interferes with anything else.
PFS_OPENROUTER_API_KEY=
OLLAMA_API_BASE=http://localhost:11434
